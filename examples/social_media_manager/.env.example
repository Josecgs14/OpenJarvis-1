# Platform credentials for the social media manager.
# Copy this file to ".env" (same folder) and fill in your tokens.
# ".env" is gitignored — it never gets committed. The agent loads it
# automatically on every run.

# --- X / Twitter -----------------------------------------------------
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# TWITTER_BEARER_TOKEN=        # read-side, used for metrics

# --- Facebook Page (Meta Graph API) ----------------------------------
# Use the PAGE id and a PAGE access token (not your user token).
# The token needs: pages_manage_posts, pages_read_engagement.
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Instagram (Meta Graph API) --------------------------------------
# IG professional account linked to the Facebook Page above.
# The token needs: instagram_basic, instagram_content_publish.
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=

# --- Mastodon --------------------------------------------------------
# MASTODON_API_BASE_URL=https://mastodon.social
# MASTODON_ACCESS_TOKEN=

# --- Buffer (easiest: one token covers IG, FB, TikTok, LinkedIn...) --
# Generate a token at https://publish.buffer.com/settings/api
# Use platform names like "buffer:facebook" / "buffer:instagram" in your
# profile, and give each a channel id (from Buffer's channel list).
# By default posts go to your Buffer QUEUE; set BUFFER_SHARE_NOW=1 to
# publish immediately.
# BUFFER_ACCESS_TOKEN=
# BUFFER_FACEBOOK_CHANNEL_ID=
# BUFFER_INSTAGRAM_CHANNEL_ID=
# BUFFER_TIKTOK_CHANNEL_ID=
# BUFFER_SHARE_NOW=0
